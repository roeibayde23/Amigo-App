# ─────────────────────────────────────────────────────────────
# Amigo – environment variables
# Copy to .env.local (never commit .env.local) and fill in.
# If the Supabase URL / publishable key are missing, the app
# runs in DEMO MODE with mock data stored in the browser.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API Keys). Public, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://ywapvsoiqgujxcmvyscp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (legacy name also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Supabase secret key (sb_secret_… or legacy service_role). SERVER ONLY.
SUPABASE_SECRET_KEY=
# (legacy name also accepted: SUPABASE_SERVICE_ROLE_KEY)

# Google OAuth client (same one configured in Supabase → Auth → Google).
# Needed by the server to refresh Gmail access tokens.
GOOGLE_CLIENT_ID=412459822797-eeffhhkvv60m2kh8qhotpjom1jl8ot8o.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=23roei23@gmail.com

# Public site URL (used for the OAuth redirect). Vercel: https://<app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
# NEXT_PUBLIC_APP_TIMEZONE=Europe/Prague
# NEXT_PUBLIC_DEMO_MODE=1          # force demo mode even when keys exist
# GMAIL_QUERY=in:inbox newer_than:14d -category:promotions -category:social
